# Copia este archivo como .streamlit/secrets.toml (local) o pega su contenido
# en Streamlit Community Cloud → App settings → Secrets.
# NUNCA subas secrets.toml a GitHub (ya está en .gitignore).

# Cadena de conexión de Supabase (Connect → Session pooler). Reemplaza [YOUR-PASSWORD].
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Usuario administrador
ADMIN_USER = "admin"

# Hash de la contraseña. Genéralo con:  python auth.py "tu-contraseña-segura"
ADMIN_PASSWORD_HASH = "pbkdf2_sha256$310000$...$..."
